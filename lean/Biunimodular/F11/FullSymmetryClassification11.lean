import Biunimodular.F11.FullSymmetryProjectivePhaseOrbit11
import Biunimodular.F11.PhaseFixedSliceExistence11

set_option autoImplicit false

namespace Biunimodular.F11

/-!
# Full projective orbits generated by non-Gaussian even signals

The seven admissible non-Gaussian invariant roots yield pairwise distinct
orbits under the full projective Fourier/Weyl symmetry action. Each orbit
contains exactly 1210 projective signal lines.
-/

noncomputable section

private def nonGaussianRootPhase11
    (r : NonGaussianSplitQuotientRoot) : PhaseSolution11 :=
  splitRootPhaseSolution11 r.1

private theorem nonGaussianRootPhase11_nonGaussian
    (r : NonGaussianSplitQuotientRoot) :
    ¬ IsQuadraticGaussianSignal11
      (phaseSolutionSignalEquiv11 (nonGaussianRootPhase11 r)) := by
  intro hG
  have hphase : IsQuadraticGaussian11 (nonGaussianRootPhase11 r) :=
    (isQuadraticGaussian11_signal_iff _).2 hG
  have hu : phaseInvariantU11 (nonGaussianRootPhase11 r).1 = 0 :=
    (isQuadraticGaussian11_iff_invariantU_eq_zero _).1 hphase
  have hz : (r.1 : ℂ) = 0 := by
    rw [← splitRootPhaseSolution11_value]
    exact_mod_cast hu
  exact r.2 ((splitQuotientRoot_eq_gaussian_iff r.1).2 hz)

/-- The full projective orbit indexed by one of the seven physical
non-Gaussian quotient roots. -/
def nonGaussianRootFullOrbit11
    (r : NonGaussianSplitQuotientRoot) :
    Set FullProjectiveSignal11 :=
  MulAction.orbit FullSymmetryLabel11
    (phaseProjective11 (nonGaussianRootPhase11 r))

private noncomputable instance (r : NonGaussianSplitQuotientRoot) :
    Fintype (nonGaussianRootFullOrbit11 r) :=
  (Finite.finite_mulAction_orbit
    (phaseProjective11 (nonGaussianRootPhase11 r))).fintype

theorem nonGaussianRootFullOrbit11_card
    (r : NonGaussianSplitQuotientRoot) :
    Fintype.card (nonGaussianRootFullOrbit11 r) = 1210 :=
  phaseProjective11_full_orbit_card_1210
    (nonGaussianRootPhase11 r) (nonGaussianRootPhase11_nonGaussian r)

theorem nonGaussianRootFullOrbit11_injective :
    Function.Injective nonGaussianRootFullOrbit11 := by
  intro r t hrt
  have htmem : phaseProjective11 (nonGaussianRootPhase11 t) ∈
      nonGaussianRootFullOrbit11 r := by
    rw [hrt]
    exact MulAction.mem_orbit_self (M := FullSymmetryLabel11) _
  obtain ⟨g, hg⟩ := phaseProjective11_full_orbit_even_reduction
    (nonGaussianRootPhase11 r) (nonGaussianRootPhase11 t)
    (nonGaussianRootPhase11_nonGaussian t) htmem
  have hu : phaseInvariantU11 (nonGaussianRootPhase11 t).1 =
      phaseInvariantU11 (nonGaussianRootPhase11 r).1 := by
    rw [hg]
    exact phaseInvariantU11_smul g _
  have hc := congrArg ((↑) : ℝ → ℂ) hu
  change (phaseInvariantU11 (splitRootPhaseSolution11 t.1).1 : ℂ) =
    (phaseInvariantU11 (splitRootPhaseSolution11 r.1).1 : ℂ) at hc
  rw [splitRootPhaseSolution11_value,
    splitRootPhaseSolution11_value] at hc
  have hroot : r.1 = t.1 := by
    apply Subtype.ext
    apply Subtype.ext
    exact hc.symm
  exact Subtype.ext hroot

/-- The seven non-Gaussian normalized-even orbits
give seven distinct 1210-point projective orbits of the actual full
Fourier/Weyl symmetry action. -/
theorem nonGaussianRootFullOrbit11_classification :
    Fintype.card NonGaussianSplitQuotientRoot = 7 ∧
    (∀ r : NonGaussianSplitQuotientRoot,
      Fintype.card (nonGaussianRootFullOrbit11 r) = 1210) ∧
    Function.Injective nonGaussianRootFullOrbit11 :=
  ⟨nonGaussianSplitQuotientRoot_card,
    nonGaussianRootFullOrbit11_card,
    nonGaussianRootFullOrbit11_injective⟩

end
end Biunimodular.F11
