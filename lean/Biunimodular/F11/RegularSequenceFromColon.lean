import Mathlib.RingTheory.Regular.RegularSequence
import Mathlib.RingTheory.Ideal.Pointwise

set_option autoImplicit false
namespace Biunimodular.F11

/-- The precise universal ideal-membership obligations used by the
homogeneous certificate export. Each successive generator must have trivial
annihilator modulo the ideal generated by its predecessors. -/
theorem regularSequence_of_prefix_colon {R : Type*} [CommRing R]
    (rs : List R) (hproper : (1 : R) ∉ Ideal.ofList rs)
    (hcolon : ∀ i (hi : i < rs.length) (x : R),
      rs[i] * x ∈ Ideal.ofList (rs.take i) → x ∈ Ideal.ofList (rs.take i)) :
    RingTheory.Sequence.IsRegular R rs := by
  have hs (I : Ideal R) : I • (⊤ : Submodule R R) = I := by
    rw [Ideal.smul_top_eq_map]
    simp
  constructor
  · constructor
    intro i hi
    rw [hs]
    apply (isSMulRegular_quotient_iff_mem_of_smul_mem _ _).mpr
    intro x hx
    exact hcolon i hi x hx
  · rw [hs]
    intro h
    exact hproper (h ▸ Submodule.mem_top)

end Biunimodular.F11
