import Mathlib.Data.Nat.Factors
import Mathlib.Data.Int.Basic
import Mathlib.Data.ZMod.Basic

set_option autoImplicit false
namespace Biunimodular.F11

/-- Constants dividing a prime power reduce to the subgroup generated by
that prime and minus one. -/
theorem primePowerDivisor_modular_power
    (base exponent modulus order : ℕ) (hb : Nat.Prime base)
    (hbase : (base : ZMod modulus)^order = 1)
    (hneg : (-1 : ZMod modulus)^order = 1)
    (x : ℤ) (hx : x ∣ (base : ℤ)^exponent) : (x : ZMod modulus)^order = 1 := by
  have hbn : (base : ℤ) ≠ 0 := by exact_mod_cast hb.ne_zero
  have hxn : x ≠ 0 := ne_zero_of_dvd_ne_zero (pow_ne_zero exponent hbn) hx
  have hnat : x.natAbs ∣ base^exponent := by
    simpa only [Int.natAbs_pow, Int.natAbs_natCast] using Int.natAbs_dvd_natAbs.mpr hx
  have hpow := Nat.eq_prime_pow_of_unique_prime_dvd (Int.natAbs_ne_zero.mpr hxn)
    (fun {d} hd hdvd => Nat.dvd_prime hb |>.mp (hd.dvd_of_dvd_pow (hdvd.trans hnat)) |>.resolve_left hd.ne_one)
  have hpower (k : ℕ) : ((base : ZMod modulus)^k)^order = 1 := by
    rw [pow_right_comm, hbase, one_pow]
  obtain h | h := Int.natAbs_eq x
  · rw [h]
    rw [Int.cast_natCast, hpow, Nat.cast_pow]
    exact hpower _
  · rw [h]
    rw [Int.cast_neg, Int.cast_natCast, hpow, Nat.cast_pow, neg_eq_neg_one_mul,
      mul_pow, hneg, hpower, one_mul]

end Biunimodular.F11
