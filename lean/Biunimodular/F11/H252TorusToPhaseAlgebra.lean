import Biunimodular.F11.H252ComplexPhaseAlgebra
import Biunimodular.F11.UnivariateCoordinateSurjectivity

set_option autoImplicit false
namespace Biunimodular.F11
noncomputable section

abbrev h252PhaseTorusZ := h252ComplexPhaseZ h252ComplexPhaseA h252ComplexPhaseB
abbrev h252PhaseTorusT := h252ComplexPhaseInverse h252ComplexPhaseA h252ComplexPhaseB

def h252PhaseTorusW : H252ComplexPhaseAlgebra :=
  h252PhaseTorusT 0 * h252PhaseTorusT 1 * h252PhaseTorusT 2 *
    h252PhaseTorusT 3 * h252PhaseTorusT 4

theorem h252PhaseTorus_unit (i : Fin 5) :
    h252PhaseTorusZ i * h252PhaseTorusT i = 1 :=
  h252ComplexPhase_units _ _ h252ComplexPhase_circle i

theorem h252PhaseTorus_saturation : h252PhaseTorusW * h252TorusDVector h252PhaseTorusZ = 1 := by
  calc
    _ = (h252PhaseTorusZ 0 * h252PhaseTorusT 0) *
        (h252PhaseTorusZ 1 * h252PhaseTorusT 1) *
        (h252PhaseTorusZ 2 * h252PhaseTorusT 2) *
        (h252PhaseTorusZ 3 * h252PhaseTorusT 3) *
        (h252PhaseTorusZ 4 * h252PhaseTorusT 4) := by
      simp only [h252PhaseTorusW, h252TorusDVector, h252TorusD]; ring
    _ = 1 := by rw [h252PhaseTorus_unit, h252PhaseTorus_unit,
      h252PhaseTorus_unit, h252PhaseTorus_unit, h252PhaseTorus_unit]; ring

def h252PhaseTorusValues : Fin 7 → H252ComplexPhaseAlgebra :=
  ![h252PhaseTorusZ 0, h252PhaseTorusZ 1, h252PhaseTorusZ 2,
    h252PhaseTorusZ 3, h252PhaseTorusZ 4, h252PhaseTorusW,
    (algebraMap ℂ H252ComplexPhaseAlgebra Complex.I) * h252ComplexPhaseB 4]

theorem h252PhaseTorus_generators_zero (i : Fin 7) :
    MvPolynomial.aeval h252PhaseTorusValues (h252LocalizedTorusGenerators i) = 0 := by
  fin_cases i
  · simpa [h252LocalizedTorusGenerators, h252PhaseTorusValues, h252TorusF1] using
      h252ComplexPhaseE1_torus _ _ h252ComplexPhase_circle h252ComplexPhase_equation1
  · simpa [h252LocalizedTorusGenerators, h252PhaseTorusValues, h252TorusF2] using
      h252ComplexPhaseE2_torus _ _ h252ComplexPhase_circle h252ComplexPhase_equation2
  · simpa [h252LocalizedTorusGenerators, h252PhaseTorusValues, h252TorusF3] using
      h252ComplexPhaseE3_torus _ _ h252ComplexPhase_circle h252ComplexPhase_equation3
  · simpa [h252LocalizedTorusGenerators, h252PhaseTorusValues, h252TorusF4] using
      h252ComplexPhaseE4_torus _ _ h252ComplexPhase_circle h252ComplexPhase_equation4
  · simpa [h252LocalizedTorusGenerators, h252PhaseTorusValues, h252TorusF5] using
      h252ComplexPhaseE5_torus _ _ h252ComplexPhase_circle h252ComplexPhase_equation5
  · simpa [h252LocalizedTorusGenerators, h252PhaseTorusValues, h252TorusS,
      h252TorusDVector, h252TorusD] using sub_eq_zero.mpr h252PhaseTorus_saturation
  · have hu := h252PhaseTorus_unit 4
    simp only [h252ComplexPhaseZ, h252ComplexPhaseInverse] at hu
    simp [h252LocalizedTorusGenerators, h252PhaseTorusValues]
    simp only [h252ComplexPhaseZ]
    linear_combination hu

def h252TorusToPhase : H252LocalizedTorusAlgebra →ₐ[ℂ] H252ComplexPhaseAlgebra :=
  Ideal.Quotient.liftₐ h252LocalizedTorusIdeal (MvPolynomial.aeval h252PhaseTorusValues)
    (by
      intro p hp
      have hi : h252LocalizedTorusIdeal ≤
          RingHom.ker (MvPolynomial.aeval h252PhaseTorusValues).toRingHom := by
        apply Ideal.span_le.mpr
        rintro q ⟨i, rfl⟩
        exact RingHom.mem_ker.mpr (h252PhaseTorus_generators_zero i)
      exact RingHom.mem_ker.mp (hi hp))

theorem h252TorusToPhase_var (i : Fin 7) :
    h252TorusToPhase (h252LocalizedTorusVar i) = h252PhaseTorusValues i := by
  change Ideal.Quotient.lift h252LocalizedTorusIdeal
    (MvPolynomial.aeval h252PhaseTorusValues).toRingHom _
    (Ideal.Quotient.mk h252LocalizedTorusIdeal (MvPolynomial.X i)) = _
  rw [Ideal.Quotient.lift_mk]
  simp

theorem h252TorusToPhase_coordinate :
    h252TorusToPhase.comp h252LocalizedTorusCoordinate = h252ComplexPhaseXCoordinate := by
  apply Polynomial.algHom_ext
  simp [h252LocalizedTorusCoordinate, h252ComplexPhaseXCoordinate,
    h252TorusToPhase_var, h252PhaseTorusValues]

theorem h252PhaseTorus_inverse_cofactor (i : Fin 5) :
    h252PhaseTorusT i = h252PhaseTorusW * h252TorusCofactor h252PhaseTorusZ i := by
  have hu := h252PhaseTorus_unit i
  have hv := h252TorusCofactor_units _ _ h252PhaseTorus_saturation i
  calc
    _ = (h252PhaseTorusZ i * (h252PhaseTorusW * h252TorusCofactor h252PhaseTorusZ i)) *
        h252PhaseTorusT i := by rw [hv, one_mul]
    _ = (h252PhaseTorusW * h252TorusCofactor h252PhaseTorusZ i) *
        (h252PhaseTorusZ i * h252PhaseTorusT i) := by ring
    _ = _ := by rw [hu, mul_one]

/-- The original circle and phase algebra is generated by the localized
torus variables. This holds for the scheme algebra, including nilpotents. -/
theorem h252TorusToPhase_surjective : Function.Surjective h252TorusToPhase := by
  have hz (i : Fin 5) : h252PhaseTorusZ i ∈ h252TorusToPhase.range := by
    refine ⟨h252LocalizedTorusVar i.castSucc.castSucc, ?_⟩
    change h252TorusToPhase (h252LocalizedTorusVar i.castSucc.castSucc) = _
    rw [h252TorusToPhase_var]
    fin_cases i <;> rfl
  have hw : h252PhaseTorusW ∈ h252TorusToPhase.range :=
    ⟨h252LocalizedTorusVar 5, h252TorusToPhase_var 5⟩
  have ht (i : Fin 5) : h252PhaseTorusT i ∈ h252TorusToPhase.range := by
    rw [h252PhaseTorus_inverse_cofactor]
    apply h252TorusToPhase.range.mul_mem hw
    fin_cases i <;> simp only [h252TorusCofactor] <;>
      exact h252TorusToPhase.range.mul_mem
        (h252TorusToPhase.range.mul_mem (h252TorusToPhase.range.mul_mem (hz _) (hz _)) (hz _))
        (hz _)
  have ha (i : Fin 5) : h252ComplexPhaseA i ∈ h252TorusToPhase.range := by
    have he : h252ComplexPhaseA i =
        (algebraMap ℂ H252ComplexPhaseAlgebra (1 / 2)) *
          (h252PhaseTorusZ i + h252PhaseTorusT i) := by
      have hs := congrArg (algebraMap ℂ H252ComplexPhaseAlgebra)
        (show (1 / 2 : ℂ) * 2 = 1 by norm_num)
      simp only [map_mul, map_ofNat, map_one] at hs
      simp only [h252ComplexPhaseZ, h252ComplexPhaseInverse]
      linear_combination -h252ComplexPhaseA i * hs
    rw [he]
    exact h252TorusToPhase.range.mul_mem (h252TorusToPhase.range.algebraMap_mem _)
      (h252TorusToPhase.range.add_mem (hz i) (ht i))
  have hb (i : Fin 5) : h252ComplexPhaseB i ∈ h252TorusToPhase.range := by
    have he : h252ComplexPhaseB i =
        (algebraMap ℂ H252ComplexPhaseAlgebra (-(Complex.I / 2))) *
          (h252PhaseTorusZ i - h252PhaseTorusT i) := by
      have hs := congrArg (algebraMap ℂ H252ComplexPhaseAlgebra)
        (show (-(Complex.I / 2)) * (2 * Complex.I) = 1 by
          calc
            _ = -Complex.I ^ 2 := by ring
            _ = 1 := by rw [Complex.I_sq]; ring)
      simp only [map_mul, map_ofNat, map_one] at hs
      simp only [h252ComplexPhaseZ, h252ComplexPhaseInverse]
      linear_combination -h252ComplexPhaseB i * hs
    rw [he]
    exact h252TorusToPhase.range.mul_mem (h252TorusToPhase.range.algebraMap_mem _)
      (h252TorusToPhase.range.sub_mem (hz i) (ht i))
  intro a
  obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective a
  change Ideal.Quotient.mkₐ ℂ h252ComplexPhaseIdeal p ∈ h252TorusToPhase.range
  induction p using MvPolynomial.induction_on with
  | C c =>
    change Ideal.Quotient.mkₐ ℂ h252ComplexPhaseIdeal
      (algebraMap ℂ H252ComplexPhasePolynomialRing c) ∈ h252TorusToPhase.range
    rw [AlgHom.commutes]
    exact h252TorusToPhase.range.algebraMap_mem c
  | add p q hp hq =>
    rw [map_add]
    exact h252TorusToPhase.range.add_mem hp hq
  | mul_X p i hp =>
    rw [map_mul]
    apply h252TorusToPhase.range.mul_mem hp
    fin_cases i
    · exact ha 0
    · exact hb 0
    · exact ha 1
    · exact hb 1
    · exact ha 2
    · exact hb 2
    · exact ha 3
    · exact hb 3
    · exact ha 4
    · exact hb 4

/-- The inverse-RUR surjectivity obligation for the seven-variable torus
presentation suffices for the original ten-equation phase algebra. -/
theorem h252ComplexPhaseXCoordinate_surjective_of_torus
    (h : Function.Surjective h252LocalizedTorusCoordinate) :
    Function.Surjective h252ComplexPhaseXCoordinate := by
  rw [← h252TorusToPhase_coordinate]
  exact h252TorusToPhase_surjective.comp h

end
end Biunimodular.F11
