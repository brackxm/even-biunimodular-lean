import Biunimodular.F11.ASectorPeriodARealization
import Mathlib.FieldTheory.Minpoly.IsConjRoot
import Biunimodular.F11.FixedSliceQuotientPolynomial

set_option autoImplicit false

namespace Biunimodular.F11

open Polynomial
open scoped IntermediateField

noncomputable section

/-- One rational embedding of the concrete conductor-77 field into the
complex numbers.  No embedding-dependent sign or physical phase is selected. -/
def conductor77ComplexEmbedding : Conductor77Cyclotomic →ₐ[ℚ] ℂ :=
  IsAlgClosed.lift

/-- The period-invariant value in this chosen complex embedding. -/
def periodInvariantU77Complex : ℂ :=
  conductor77ComplexEmbedding periodInvariantU77

theorem periodInvariantU77Complex_minpoly :
    minpoly ℚ periodInvariantU77Complex =
      invariantA.map (Int.castRingHom ℚ) := by
  rw [periodInvariantU77Complex,
    minpoly.algHom_eq conductor77ComplexEmbedding
      conductor77ComplexEmbedding.injective,
    periodInvariantU77_minpoly]

/-- Every complex root of the actual A factor has the same minimal
polynomial as the explicit Gaussian-period invariant. -/
theorem fixedSliceAQuotientRoot_minpoly (r : FixedSliceAQuotientRoot) :
    minpoly ℚ (r : ℂ) =
      invariantA.map (Int.castRingHom ℚ) := by
  have hroot : (aeval (r : ℂ))
      (invariantA.map (Int.castRingHom ℚ)) = 0 := by
    exact (mem_rootSet.mp r.2).2
  exact (minpoly.eq_of_irreducible_of_monic
    invariantA_irreducible_over_Q hroot
    (invariantA_monic.map (Int.castRingHom ℚ))).symm

/-- The six roots of the quotient's A component are rational conjugates of
the period expression `N(η)/13`. -/
theorem fixedSliceAQuotientRoot_conj_periodInvariant
    (r : FixedSliceAQuotientRoot) :
    IsConjRoot ℚ (r : ℂ) periodInvariantU77Complex := by
  change minpoly ℚ (r : ℂ) = minpoly ℚ periodInvariantU77Complex
  rw [fixedSliceAQuotientRoot_minpoly,
    periodInvariantU77Complex_minpoly]

/-- The field generated by any root of the concrete A quotient factor is
isomorphic to the embedded Gaussian-period invariant field. -/
def fixedSliceAQuotientRoot_fieldEquivPeriod
    (r : FixedSliceAQuotientRoot) :
    ℚ⟮(r : ℂ)⟯ ≃ₐ[ℚ] ℚ⟮periodInvariantU77Complex⟯ := by
  have hr : IsIntegral ℚ (r : ℂ) :=
    minpoly.ne_zero_iff.mp (by
      rw [fixedSliceAQuotientRoot_minpoly]
      exact invariantA_irreducible_over_Q.ne_zero)
  exact minpoly.algEquiv hr.isAlgebraic
    (fixedSliceAQuotientRoot_conj_periodInvariant r)

/-- The abstract Gaussian-period sextic is the field generated by its
invariant value in the chosen complex embedding. -/
def conductor77PeriodField_complexEquiv :
    conductor77PeriodField ≃ₐ[ℚ] ℚ⟮periodInvariantU77Complex⟯ := by
  have hmap : conductor77PeriodField.map conductor77ComplexEmbedding =
      ℚ⟮periodInvariantU77Complex⟯ := by
    rw [← periodInvariantU77_generates_periodField,
      IntermediateField.adjoin_map]
    simp [periodInvariantU77Complex]
  exact (conductor77PeriodField.equivMap conductor77ComplexEmbedding).trans
    (IntermediateField.equivOfEq hmap)

/-- Every actual quotient A-root generates a field isomorphic to the
concrete conductor-77 Gaussian-period sextic. -/
def fixedSliceAQuotientRoot_fieldEquivConductor77Period
    (r : FixedSliceAQuotientRoot) :
    ℚ⟮(r : ℂ)⟯ ≃ₐ[ℚ] conductor77PeriodField :=
  (fixedSliceAQuotientRoot_fieldEquivPeriod r).trans
    conductor77PeriodField_complexEquiv.symm

end
end Biunimodular.F11
