set_option autoImplicit false

namespace Biunimodular.F11

open Polynomial

noncomputable def BMonicQ : ℚ[X] :=
  invariantBMonicTransform.map (Int.castRingHom ℚ)

abbrev BSplit := BOriginalQ.SplittingField
noncomputable instance : NumberField BSplit :=
  NumberField.of_module_finite ℚ BSplit

instance : IsGalois ℚ BSplit := by
  have hsep : BOriginalQ.Separable := by
    simpa only [BOriginalQ] using invariantB_irreducible_over_Q_closed.separable
  exact IsGalois.of_separable_splitting_field hsep

noncomputable abbrev BIntegers := NumberField.RingOfIntegers BSplit

example : IsFractionRing BIntegers BSplit := inferInstance
example : IsIntegralClosure BIntegers ℤ BSplit := inferInstance

noncomputable instance : MulSemiringAction BOriginalQ.Gal BIntegers :=
  IsIntegralClosure.MulSemiringAction ℤ ℚ BSplit BIntegers

example : SMulCommClass BOriginalQ.Gal ℤ BIntegers := inferInstance

instance : Algebra.IsInvariant ℤ BIntegers BOriginalQ.Gal :=
  Algebra.isInvariant_of_isGalois ℤ ℚ BSplit BIntegers

/-- The prime ideal of `ℤ` generated by a rational prime. -/
def bBasePrimeIdeal (p : ℕ) : Ideal ℤ := Ideal.span {(p : ℤ)}

/-- Every rational prime admits an arithmetic Frobenius element in the
actual Galois group of the monic B transform. -/
theorem exists_bMonic_arithFrob_at_prime (p : ℕ) (hp : Nat.Prime p) :
    ∃ Q : Ideal BIntegers, Q.IsMaximal ∧ Q.IsPrime ∧
      Q.under ℤ = bBasePrimeIdeal p ∧
      ∃ σ : BOriginalQ.Gal, IsArithFrobAt ℤ σ Q := by
  let : Fact (Nat.Prime p) := ⟨hp⟩
  have : (bBasePrimeIdeal p).IsMaximal := by
    change (Ideal.span {(p : ℤ)}).IsMaximal
    infer_instance
  obtain ⟨Q, hmax, hover⟩ :=
    Ideal.exists_maximal_ideal_liesOver_of_isIntegral
      (S := BIntegers) (bBasePrimeIdeal p)
  let : Q.IsMaximal := hmax
  let : Q.IsPrime := hmax.isPrime
  have : NeZero Q := inferInstance
  have : Finite (BIntegers ⧸ Q) := inferInstance
  obtain ⟨σ, hσ⟩ := IsArithFrobAt.exists_of_isInvariant ℤ BOriginalQ.Gal Q
  exact ⟨Q, hmax, inferInstance, hover.over.symm, σ, hσ⟩

/-- Arithmetic Frobenius at a prime over `p` raises every integral element
to its `p`-th power after reduction. -/
theorem exists_bMonic_frobenius_power (p : ℕ) (hp : Nat.Prime p) :
    ∃ (Q : Ideal BIntegers) (σ : BOriginalQ.Gal), Q.IsPrime ∧
      Q.under ℤ = bBasePrimeIdeal p ∧
      ∀ x : BIntegers,
        Ideal.Quotient.mk Q (σ • x) = (Ideal.Quotient.mk Q x) ^ p := by
  obtain ⟨Q, _, hQ, hunder, σ, hσ⟩ := exists_bMonic_arithFrob_at_prime p hp
  refine ⟨Q, σ, hQ, hunder, ?_⟩
  intro x
  have hcard : Nat.card (ℤ ⧸ Q.under ℤ) = p := by
    rw [hunder, bBasePrimeIdeal]
    exact Int.card_ideal_quot p
  simpa only [MulSemiringAction.toAlgHom_apply, hcard] using hσ.mk_apply x

/-- The roots of the monic B transform are algebraic integers. -/
noncomputable def bMonicIntegralRootEquiv :
    invariantBMonicTransform.rootSet BIntegers ≃
      invariantBMonicTransform.rootSet BSplit := by
  let p := invariantBMonicTransform
  let hp : p.Monic := invariantBMonicTransform_monic
  let f : p.rootSet BIntegers → p.rootSet BSplit := fun x =>
    ⟨algebraMap BIntegers BSplit x.1, by
      apply hp.mem_rootSet.mpr
      have hx := (hp.mem_rootSet).mp x.2
      calc
        aeval (algebraMap BIntegers BSplit x.1) p =
            (IsScalarTower.toAlgHom ℤ BIntegers BSplit) (aeval x.1 p) := by
              simpa only [IsScalarTower.toAlgHom_apply] using
                (aeval_algHom_apply
                  (IsScalarTower.toAlgHom ℤ BIntegers BSplit) x.1 p)
        _ = 0 := by rw [hx]; simp⟩
  apply Equiv.ofBijective f
  constructor
  · intro x y hxy
    apply Subtype.ext
    apply NumberField.RingOfIntegers.coe_injective
    simpa only [f] using
      congrArg (fun z : p.rootSet BSplit => (z : BSplit)) hxy
  · intro x
    have hx : aeval x.1 p = 0 := (hp.mem_rootSet).mp x.2
    let y : BIntegers := ⟨x.1, ⟨p, hp, hx⟩⟩
    have hy : y ∈ p.rootSet BIntegers := by
      apply hp.mem_rootSet.mpr
      apply NumberField.RingOfIntegers.coe_injective
      have h := aeval_algHom_apply
        (IsScalarTower.toAlgHom ℤ BIntegers BSplit) y p
      have hmapzero : (IsScalarTower.toAlgHom ℤ BIntegers BSplit) (aeval y p) = 0 := by
        rw [← h]
        change aeval x.1 p = 0
        exact hx
      simpa only [IsScalarTower.toAlgHom_apply, map_zero] using hmapzero
    exact ⟨⟨y, hy⟩, Subtype.ext rfl⟩

private theorem bMonicQ_degree : BMonicQ.natDegree = 8 := by
  norm_num [BMonicQ, invariantBMonicTransform]
  compute_degree <;> norm_num

/-- There are exactly eight integral roots of the monic B transform. -/
theorem bMonicIntegralRoot_card :
    Fintype.card (invariantBMonicTransform.rootSet BIntegers) = 8 := by
  rw [Fintype.card_congr bMonicIntegralRootEquiv]
  have hcast : Int.castRingHom ℚ = algebraMap ℤ ℚ := by ext; rfl
  have hset : invariantBMonicTransform.rootSet BSplit = BMonicQ.rootSet BSplit := by
    simpa only [BMonicQ, hcast] using
      (Polynomial.rootSet_map BSplit ℚ invariantBMonicTransform).symm
  have hcardL : Fintype.card (BMonicQ.rootSet BSplit) = 8 := by
    rw [Polynomial.card_rootSet_eq_natDegree
      (by simpa only [BMonicQ] using invariantBMonicTransform_irreducible_over_Q.separable)
      (by simpa only [BMonicQ, BMonicQOriginal, BSplit] using
        bMonic_splits_in_original_splittingField)]
    exact bMonicQ_degree
  simpa only [hset] using hcardL

/-- The monic integer polynomial already splits in the ring of integers of
its splitting field. -/
theorem bMonicInteger_splits :
    (invariantBMonicTransform.map (algebraMap ℤ BIntegers)).Splits := by
  let f : BIntegers[X] := invariantBMonicTransform.map (algebraMap ℤ BIntegers)
  have hcomp : (algebraMap BIntegers BSplit).comp (algebraMap ℤ BIntegers) =
      (algebraMap ℚ BSplit).comp (Int.castRingHom ℚ) := by
    ext n
    simp
  have hL0 : (invariantBMonicTransform.map
      ((algebraMap ℚ BSplit).comp (Int.castRingHom ℚ))).Splits := by
    have hsplit := bMonic_splits_in_original_splittingField
    change (BMonicQ.map (algebraMap ℚ BSplit)).Splits at hsplit
    unfold BMonicQ at hsplit
    rw [Polynomial.map_map] at hsplit
    exact hsplit
  have hL : (f.map (algebraMap BIntegers BSplit)).Splits := by
    simpa only [f, Polynomial.map_map, hcomp] using hL0
  apply hL.of_splits_algebraMap
  intro a ha
  have ha' : a ∈ invariantBMonicTransform.rootSet BSplit := by
    simpa only [f, Polynomial.rootSet_map] using ha
  obtain ⟨x, hx⟩ := bMonicIntegralRootEquiv.surjective ⟨a, ha'⟩
  exact ⟨x.1, congrArg Subtype.val hx⟩

/-- The residue field at a prime above `p` has characteristic `p`. -/
theorem bResidue_charP (p : ℕ) (Q : Ideal BIntegers)
    (hunder : Q.under ℤ = bBasePrimeIdeal p) :
    CharP (BIntegers ⧸ Q) p := by
  apply ringChar.of_eq
  calc
    ringChar (BIntegers ⧸ Q) = (Q.under ℤ).absNorm := Ideal.ringChar_quot Q
    _ = (bBasePrimeIdeal p).absNorm := by rw [hunder]
    _ = p := by simp [bBasePrimeIdeal]

/-- Separability modulo `p` passes to any residue field above `p`. -/
theorem bMonic_residue_separable_of_modp
    (p : ℕ) (Q : Ideal BIntegers)
    (hunder : Q.under ℤ = bBasePrimeIdeal p)
    (hsep : (invariantBMonicTransform.map
      (Int.castRingHom (ZMod p))).Separable) :
    (invariantBMonicTransform.map
      (algebraMap ℤ (BIntegers ⧸ Q))).Separable := by
  let : CharP (BIntegers ⧸ Q) p := bResidue_charP p Q hunder
  let φ : ZMod p →+* BIntegers ⧸ Q := ZMod.castHom (dvd_refl p) _
  have hcomp : φ.comp (Int.castRingHom (ZMod p)) =
      algebraMap ℤ (BIntegers ⧸ Q) := by
    ext n
    simp [φ]
  have h := hsep.map (f := φ)
  rw [Polynomial.map_map, hcomp] at h
  exact h

private theorem bMonicZ_degree : invariantBMonicTransform.natDegree = 8 := by
  have h := invariantBMonicTransform_monic.natDegree_map (Int.castRingHom ℚ)
  simpa only [BMonicQ] using h.symm.trans bMonicQ_degree

/-- At a prime where the monic B reduction is separable, reduction gives a
bijection on all eight roots. -/
noncomputable def bMonicRootReductionEquiv
    (p : ℕ) (Q : Ideal BIntegers) [Q.IsPrime]
    (hunder : Q.under ℤ = bBasePrimeIdeal p)
    (hsep : (invariantBMonicTransform.map
      (Int.castRingHom (ZMod p))).Separable) :
    invariantBMonicTransform.rootSet BIntegers ≃
      invariantBMonicTransform.rootSet (BIntegers ⧸ Q) := by
  have hsepQ := bMonic_residue_separable_of_modp p Q hunder hsep
  have hinj := monicRootReduction_injective_of_separable
    invariantBMonicTransform invariantBMonicTransform_monic Q
    bMonicInteger_splits hsepQ
  have hupper : Fintype.card
      (invariantBMonicTransform.rootSet (BIntegers ⧸ Q)) ≤ 8 := by
    rw [Set.fintypeCard_eq_ncard]
    exact (Polynomial.ncard_rootSet_le invariantBMonicTransform (BIntegers ⧸ Q)).trans_eq
      bMonicZ_degree
  have hcard : Fintype.card
      (invariantBMonicTransform.rootSet BIntegers) =
      Fintype.card (invariantBMonicTransform.rootSet (BIntegers ⧸ Q)) := by
    have hlow := Fintype.card_le_of_injective
      (monicRootReduction invariantBMonicTransform invariantBMonicTransform_monic Q) hinj
    rw [bMonicIntegralRoot_card] at hlow
    rw [bMonicIntegralRoot_card]
    omega
  exact monicRootReductionEquiv invariantBMonicTransform
    invariantBMonicTransform_monic Q hinj hcard

/-- A Frobenius cycle in the residue field lifts to the permutation of the
eight integral roots induced by the arithmetic Frobenius element. -/
theorem bMonic_arithFrob_cycle_transfer
    (p : ℕ) (Q : Ideal BIntegers) [Q.IsPrime]
    (hunder : Q.under ℤ = bBasePrimeIdeal p)
    (hsep : (invariantBMonicTransform.map
      (Int.castRingHom (ZMod p))).Separable)
    (σ : BOriginalQ.Gal) (hσ : IsArithFrobAt ℤ σ Q)
    (g : Equiv.Perm (invariantBMonicTransform.rootSet (BIntegers ⧸ Q)))
    (hgpow : ∀ x, (g x).1 = (x.1 : BIntegers ⧸ Q) ^ p)
    (hgcycle : g.IsCycle) :
    (MulAction.toPermHom BOriginalQ.Gal
      (invariantBMonicTransform.rootSet BIntegers) σ).IsCycle := by
  let e := bMonicRootReductionEquiv p Q hunder hsep
  have hcard : Nat.card (ℤ ⧸ Q.under ℤ) = p := by
    rw [hunder, bBasePrimeIdeal]
    exact Int.card_ideal_quot p
  apply isCycle_of_equivariant_equiv e _ g
  · intro x
    apply Subtype.ext
    exact (monicRootReduction_arithFrob invariantBMonicTransform
      invariantBMonicTransform_monic Q σ hσ x).trans (by
        rw [hcard]
        exact (hgpow (e x)).symm)
  · exact hgcycle

theorem bMonic_arithFrob_support_transfer
    (p : ℕ) (Q : Ideal BIntegers) [Q.IsPrime]
    [DecidableEq (invariantBMonicTransform.rootSet BIntegers)]
    [DecidableEq (invariantBMonicTransform.rootSet (BIntegers ⧸ Q))]
    (hunder : Q.under ℤ = bBasePrimeIdeal p)
    (hsep : (invariantBMonicTransform.map
      (Int.castRingHom (ZMod p))).Separable)
    (σ : BOriginalQ.Gal) (hσ : IsArithFrobAt ℤ σ Q)
    (g : Equiv.Perm (invariantBMonicTransform.rootSet (BIntegers ⧸ Q)))
    (hgpow : ∀ x, (g x).1 = (x.1 : BIntegers ⧸ Q) ^ p) :
    (MulAction.toPermHom BOriginalQ.Gal
      (invariantBMonicTransform.rootSet BIntegers) σ).support.card =
      g.support.card := by
  classical
  let e := bMonicRootReductionEquiv p Q hunder hsep
  have hcard : Nat.card (ℤ ⧸ Q.under ℤ) = p := by
    rw [hunder, bBasePrimeIdeal]
    exact Int.card_ideal_quot p
  apply support_card_eq_of_equivariant_equiv e _ g
  intro x
  apply Subtype.ext
  exact (monicRootReduction_arithFrob invariantBMonicTransform
    invariantBMonicTransform_monic Q σ hσ x).trans (by
      rw [hcard]
      exact (hgpow (e x)).symm)

end Biunimodular.F11
