def p150G5Y11 : ℤ[X] := polynomialOfCoefficientsZ p150G5Coeffs11
def p150F30Y11 : ℤ[X] := polynomialOfCoefficientsZ p150F30Coeffs11
def p150F40Y11 : ℤ[X] := polynomialOfCoefficientsZ p150F40Coeffs11
def p150SquaredY11 : ℤ[X] := p150G5Y11 * p150F30Y11 * p150F40Y11

/-- The degree-150 real-root factor, obtained from `y = k²`. -/
def p150K11 : ℤ[X] := p150SquaredY11.comp (X ^ 2)

def r102SquaredY11 : ℤ[X] := polynomialOfCoefficientsZ r102SquaredCoeffs11

/-- The even degree-102 cofactor in the full complex eliminant. -/
def r102K11 : ℤ[X] := r102SquaredY11.comp (X ^ 2)

/-- The full degree-252 complex coordinate eliminant. -/
def h252K11 : ℤ[X] := p150K11 * r102K11

theorem p150G5Coeffs11_length : p150G5Coeffs11.length = 6 := by native_decide
theorem p150F30Coeffs11_length : p150F30Coeffs11.length = 31 := by native_decide
theorem p150F40Coeffs11_length : p150F40Coeffs11.length = 41 := by native_decide
theorem r102SquaredCoeffs11_length : r102SquaredCoeffs11.length = 52 := by native_decide

theorem h252K11_factor : h252K11 = p150K11 * r102K11 := rfl

theorem p150K11_eval (k : ℤ) : p150K11.eval k = p150SquaredY11.eval (k ^ 2) := by
  simp [p150K11, Polynomial.eval_comp]

theorem r102K11_eval (k : ℤ) : r102K11.eval k = r102SquaredY11.eval (k ^ 2) := by
  simp [r102K11, Polynomial.eval_comp]

end

