/-- The monic transform has exactly the stated scaling relationship to
`p150F30Coeffs11`, the original squared-coordinate factor. -/
theorem aSectorG30_coeffs_scaled :
    ∀ i : Fin 31, p150F30Coeffs11[i.val]! =
      aSectorG30Coeffs[i.val]! * (4 : ℤ) ^ i.val := by
  native_decide

