theorem aSectorG30_monic : aSectorG30.Monic := by
  have hlow : g30lowZ.degree < 30 := by
    simp only [g30lowZ]
    compute_degree; norm_num
  rw [show aSectorG30 = X^30 + g30lowZ by
    simp only [aSectorG30, g30lowZ]; ring]
  exact monic_X_pow_add hlow

theorem aSectorG30_natDegree : aSectorG30.natDegree = 30 := by
  rw [show aSectorG30 = X^30 + g30lowZ by
    simp only [aSectorG30, g30lowZ]; ring]
  have hlow : g30lowZ.degree < 30 := by
    simp only [g30lowZ]
    compute_degree; norm_num
  have hlow' : g30lowZ.natDegree < 30 := by
    by_cases hz : g30lowZ = 0
    · simp [hz]
    · exact (natDegree_lt_iff_degree_lt hz).mpr hlow
  have hlt : g30lowZ.natDegree < (X^30 : ℤ[X]).natDegree := by
    simpa using hlow'
  rw [natDegree_add_eq_left_of_natDegree_lt hlt, natDegree_X_pow]

theorem aSectorG30_mod2 :
    aSectorG30.map (Int.castRingHom (ZMod 2)) = aSectorG30mod2 := by
  norm_num [aSectorG30, aSectorG30mod2]
  all_goals reduce_mod_char

theorem aSectorG30_irreducible_over_Q :
    Irreducible (aSectorG30.map (Int.castRingHom ℚ)) := by
  have hZ : Irreducible aSectorG30 := by
    apply aSectorG30_monic.irreducible_of_irreducible_map
      (Int.castRingHom (ZMod 2))
    rw [aSectorG30_mod2]
    exact aSectorG30mod2_irreducible
  exact (aSectorG30_monic.irreducible_iff_irreducible_map_fraction_map).1 hZ

