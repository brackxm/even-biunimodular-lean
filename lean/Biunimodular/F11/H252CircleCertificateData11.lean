private theorem h252CircleLiftCoeffs_eq_homogeneous11 :
    h252CircleLiftCoeffs11 =
      h252HomogenizeCoefficientsZ h252XCoeffs11 := by
  native_decide

private theorem h252XCoeffs_eq_y11 :
    h252XCoeffs11 = h252XFromYCoefficientsZ h252YCoeffs11 := by
  native_decide

noncomputable section

def h252EvalCoefficientsC : List ℤ → ℂ → ℂ
  | [], _ => 0
  | c :: cs, x => c + x * h252EvalCoefficientsC cs x

def h252CircleLiftEval11 (z : ℂ) : ℂ :=
  h252EvalCoefficientsC h252CircleLiftCoeffs11 z

def h252InXEval11 (x : ℂ) : ℂ :=
  h252EvalCoefficientsC h252YCoeffs11 (-(x^2))

def h252CoordinateEval11 (k : ℂ) : ℂ :=
  h252EvalCoefficientsC h252YCoeffs11 (k^2)

private theorem h252EvalCoefficients_add11 (xs ys : List ℤ) (z : ℂ) :
    h252EvalCoefficientsC (h252CoefficientAddZ xs ys) z =
      h252EvalCoefficientsC xs z + h252EvalCoefficientsC ys z := by
  induction xs generalizing ys with
  | nil => simp [h252CoefficientAddZ, h252EvalCoefficientsC]
  | cons x xs ih =>
      cases ys with
      | nil => simp [h252CoefficientAddZ, h252EvalCoefficientsC]
      | cons y ys =>
          simp [h252CoefficientAddZ, h252EvalCoefficientsC, ih]
          ring

theorem h252EvalCoefficients_scale11 (c : ℤ) (xs : List ℤ)
    (z : ℂ) :
    h252EvalCoefficientsC (h252CoefficientScaleZ c xs) z =
      c * h252EvalCoefficientsC xs z := by
  induction xs with
  | nil => simp [h252CoefficientScaleZ, h252EvalCoefficientsC]
  | cons x xs ih =>
      simp [h252CoefficientScaleZ, h252EvalCoefficientsC, ih]
      ring

theorem h252EvalCoefficients_mul11 (xs ys : List ℤ) (z : ℂ) :
    h252EvalCoefficientsC (h252CoefficientMulZ xs ys) z =
      h252EvalCoefficientsC xs z * h252EvalCoefficientsC ys z := by
  induction xs with
  | nil =>
      cases ys <;>
        simp only [h252CoefficientMulZ, h252EvalCoefficientsC, zero_mul]
  | cons x xs ih =>
      cases ys with
      | nil => simp [h252CoefficientMulZ, h252EvalCoefficientsC]
      | cons y ys =>
          rw [h252CoefficientMulZ, h252EvalCoefficients_add11,
            h252EvalCoefficients_scale11]
          simp [h252EvalCoefficientsC, ih]
          ring

private theorem h252Eval_scaledMonomial11 (c : ℤ) (n : ℕ) (z : ℂ) :
    h252EvalCoefficientsC (h252ScaledMonomialZ c n) z =
      c * (2*z)^n := by
  induction n generalizing c with
  | zero => simp [h252ScaledMonomialZ, h252EvalCoefficientsC]
  | succ n ih =>
      simp [h252ScaledMonomialZ, h252EvalCoefficientsC, ih, pow_succ]
      ring

private theorem h252Eval_xFromY11 (cs : List ℤ) (x : ℂ) :
    h252EvalCoefficientsC (h252XFromYCoefficientsZ cs) x =
      h252EvalCoefficientsC cs (-(x^2)) := by
  induction cs with
  | nil => simp [h252XFromYCoefficientsZ, h252EvalCoefficientsC]
  | cons c cs ih =>
      cases cs with
      | nil => simp [h252XFromYCoefficientsZ, h252EvalCoefficientsC]
      | cons d ds =>
          simp [h252XFromYCoefficientsZ, h252EvalCoefficientsC,
            h252EvalCoefficients_scale11, ih]
          ring

private theorem h252Homogenize_eval11 (c : ℤ) (cs : List ℤ)
    (z x : ℂ) (hrel : z ^ 2 - 1 = 2 * z * x) :
    h252EvalCoefficientsC (h252HomogenizeCoefficientsZ (c :: cs)) z =
      (2 * z) ^ cs.length *
        h252EvalCoefficientsC (c :: cs) x := by
  induction cs generalizing c with
  | nil =>
      norm_num [h252HomogenizeCoefficientsZ, h252ScaledMonomialZ,
        h252CoefficientMulZ, h252CoefficientAddZ,
        h252EvalCoefficientsC]
  | cons d ds ih =>
      rw [h252HomogenizeCoefficientsZ, h252EvalCoefficients_add11,
        h252Eval_scaledMonomial11, h252EvalCoefficients_mul11, ih d]
      simp only [h252EvalCoefficientsC, List.length_cons]
      norm_num
      have hrel' : -1 + z * z = 2 * z * x := by
        calc
          -1 + z * z = z ^ 2 - 1 := by ring
          _ = 2 * z * x := hrel
      rw [hrel', pow_succ]
      ring

/-- The polynomial circle lift is the degree-252 homogenization of
`H252(-i*x)`. -/
theorem h252CircleLift_substitution11 (z x : ℂ)
    (hrel : z ^ 2 - 1 = 2 * z * x) :
    h252CircleLiftEval11 z = (2 * z) ^ 252 * h252InXEval11 x := by
  rw [h252CircleLiftEval11, h252CircleLiftCoeffs_eq_homogeneous11]
  have hhead : h252XCoeffs11 =
      (368119425571165542286118799473772170496737740088423291928663528384655324338179047324162795860808586281984 : ℤ) :: h252XCoeffs11.tail := by native_decide
  rw [hhead]
  rw [h252Homogenize_eval11 _ _ z x hrel]
  have hlen : h252XCoeffs11.tail.length = 252 := by native_decide
  rw [hlen]
  congr 1
  rw [← hhead, h252XCoeffs_eq_y11, h252Eval_xFromY11]
  rfl

/-- Substituting `x = i*k` in `H252(-i*x)` recovers `H252(k)`. -/
theorem h252InXEval_I11 (k : ℝ) :
    h252InXEval11 (Complex.I * (k : ℂ)) =
      h252CoordinateEval11 (k : ℂ) := by
  simp only [h252InXEval11, h252CoordinateEval11]
  congr 1
  simp [mul_pow]

private theorem h252CoordinateEval_integer11 (k : ℂ) :
    h252CoordinateEval11 k =
      (h252K11.map (Int.castRingHom ℂ)).eval k := by
  simp [h252CoordinateEval11, h252EvalCoefficientsC, h252YCoeffs11,
    h252K11, p150K11, p150SquaredY11, p150G5Y11, p150F30Y11,
    p150F40Y11, r102K11, r102SquaredY11, polynomialOfCoefficientsZ,
    p150G5Coeffs11, p150F30Coeffs11, p150F40Coeffs11,
    r102SquaredCoeffs11]
  ring

/-- The generated scalar evaluator is exactly the complex image of the
kernel-facing rational polynomial `h252KQ11`. -/
theorem h252CoordinateEval_eq11 (k : ℂ) :
    h252CoordinateEval11 k =
      (h252KQ11.map (algebraMap ℚ ℂ)).eval k := by
  rw [h252KQ11_eq_map_integer, Polynomial.map_map]
  have hhom : (algebraMap ℚ ℂ).comp (Int.castRingHom ℚ) =
      Int.castRingHom ℂ := by
    ext n
    simp
  rw [hhom]
  exact h252CoordinateEval_integer11 k

end

