def torusReferencePureBounds : Fin 7 → ℕ :=
  ![4, 4, 4, 4, 2, 5, 5]

def torusReferenceExponentBox : Finset (Fin 7 → ℕ) :=
  Fintype.piFinset (fun i => Finset.range (torusReferencePureBounds i))

def torusReferenceStandardFunctions : Finset (Fin 7 → ℕ) :=
  torusReferenceExponentBox.filter
    (fun e => ∀ l ∈ torusReferenceLeadingExponents, ¬ ∀ i, l i ≤ e i)

theorem torusReferenceLeadingExponents_card :
    torusReferenceLeadingExponents.card = 246 := by native_decide

theorem torusReferencePurePowers : ∀ i : Fin 7,
    (fun j => if i = j then torusReferencePureBounds i else 0) ∈
      torusReferenceLeadingExponents := by native_decide

theorem torusReferenceStandardFunctions_card :
    torusReferenceStandardFunctions.card = 252 := by native_decide

end Biunimodular.F11
