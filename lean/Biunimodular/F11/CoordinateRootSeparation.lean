import Biunimodular.F11.EliminationIdealFromRootLifts

set_option autoImplicit false
namespace Biunimodular.F11
open Polynomial

/-- Root evaluations distinguish elements of an algebra generated by a coordinate
with a separable split defining polynomial. -/
theorem coordinate_eq_of_root_evaluations
    {K A : Type*} [Field K] [CommRing A] [Algebra K A]
    (f : K[X] →ₐ[K] A) (p : K[X]) (hp : p.Separable)
    (hsplit : p.Splits) (hsurj : Function.Surjective f)
    (hker : RingHom.ker f = Ideal.span ({p} : Set K[X]))
    (g : ∀ x : K, p.IsRoot x → A →ₐ[K] K)
    (hg : ∀ x hx, g x hx (f X) = x)
    (a b : A) (hab : ∀ x hx, g x hx a = g x hx b) : a = b := by
  obtain ⟨q, hq⟩ := hsurj (a - b)
  have hdiv : p ∣ q := by
    by_cases hq0 : q = 0
    · simp [hq0]
    apply hsplit.dvd_of_roots_le_roots hp.ne_zero
    apply (Multiset.le_iff_subset (Polynomial.nodup_roots hp)).mpr
    intro x hx
    have hpx : p.IsRoot x := (Polynomial.mem_roots hp.ne_zero).mp hx
    have hcomp : (g x hpx).comp f = Polynomial.aeval x := by
      apply Polynomial.algHom_ext
      simpa using hg x hpx
    apply (Polynomial.mem_roots hq0).mpr
    change q.eval x = 0
    have heval : ((g x hpx).comp f) q = 0 := by
      change g x hpx (f q) = 0
      rw [hq, map_sub, hab x hpx, sub_self]
    simpa [hcomp] using heval
  have hzero : f q = 0 := by
    apply RingHom.mem_ker.mp
    rw [hker]
    exact Ideal.mem_span_singleton.mpr hdiv
  exact sub_eq_zero.mp (hq.symm.trans hzero)

end Biunimodular.F11
