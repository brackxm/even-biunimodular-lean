theorem homogeneousCompletion5_certified_pair_tags :
    homogeneousCompletion5CertifiedPairs.map Sigma.fst = homogeneousCompletion5PairList := by rfl

theorem homogeneousCompletion5_certified_pair_tag (r : Fin 351) :
    (homogeneousCompletion5CertifiedPairs[r.val]).1 = homogeneousCompletion5Pairs r := by
  change (homogeneousCompletion5CertifiedPairs[r.val]).1 = homogeneousCompletion5PairList[r.val]
  have h : (homogeneousCompletion5CertifiedPairs.map Sigma.fst)[r.val] =
      (homogeneousCompletion5CertifiedPairs[r.val]).1 := List.getElem_map Sigma.fst
  simpa only [homogeneousCompletion5_certified_pair_tags] using h.symm

def homogeneousCompletion5Certificates (r : Fin 351) : CriticalRelationCertificate homogeneousGrevlexOrder homogeneousCompletion5GPoly (homogeneousCompletion5MPoly (Fin.last 4)) homogeneousCompletion5PreviousIdeal (homogeneousCompletion5Pairs r) := by
  have h := homogeneousCompletion5_certified_pair_tag r
  exact h ▸ (homogeneousCompletion5CertifiedPairs[r.val]).2

def homogeneousCompletion5Family : Fin 351 → Fin 27 → MvPolynomial (Fin 6) ℂ :=
  fun r => (homogeneousCompletion5Certificates r).v

theorem homogeneousCompletion5_relations (r : Fin 351) :
    (∑ k, homogeneousCompletion5Family r k * homogeneousCompletion5GPoly k) = 0 := by
  exact (homogeneousCompletion5Certificates r).relation

theorem homogeneousCompletion5_labels (r : Fin 351) :
    relationLabelMap (homogeneousCompletion5MPoly (Fin.last 4)) (homogeneousCompletion5Family r) ∈ homogeneousCompletion5PreviousIdeal := by
  exact (homogeneousCompletion5Certificates r).label

theorem homogeneousCompletion5_tops (r : Fin 351) :
    homogeneousCompletion5Family r (homogeneousCompletion5Pairs r).2 * homogeneousCompletion5GPoly (homogeneousCompletion5Pairs r).2 ≠ 0 ∧
      homogeneousGrevlexOrder.degree (homogeneousCompletion5Family r (homogeneousCompletion5Pairs r).2 * homogeneousCompletion5GPoly (homogeneousCompletion5Pairs r).2) =
        homogeneousGrevlexOrder.degree (homogeneousCompletion5GPoly (homogeneousCompletion5Pairs r).1) ⊔
          homogeneousGrevlexOrder.degree (homogeneousCompletion5GPoly (homogeneousCompletion5Pairs r).2) ∧
      ∀ k, schreyerKey homogeneousGrevlexOrder homogeneousCompletion5GPoly (homogeneousCompletion5Family r) k ≤
        schreyerKey homogeneousGrevlexOrder homogeneousCompletion5GPoly (homogeneousCompletion5Family r) (homogeneousCompletion5Pairs r).2 := by
  exact (homogeneousCompletion5Certificates r).top

theorem homogeneousCompletion5_all_relation_last
    (v : Fin 5 → MvPolynomial (Fin 6) ℂ)
    (hv : (∑ j, v j * homogeneousCompletion5OriginalPoly j) = 0) :
    v (Fin.last 4) ∈ homogeneousCompletion5PreviousIdeal := by
  apply original_relation_last_mem_of_critical_pairs homogeneousGrevlexOrder
    homogeneousCompletion5OriginalPoly homogeneousCompletion5GPoly homogeneousCompletion5MPoly homogeneousCompletion5NPoly homogeneousCompletion5Family
    homogeneousCompletion5PreviousIdeal homogeneousCompletion5_basis_nonzero homogeneousCompletion5_relations ?_
    homogeneousCompletion5_reverse homogeneousCompletion5_residual homogeneousCompletion5_labels v hv
  intro i j hij
  obtain ⟨r, hr⟩ := homogeneousCompletion5_pair_coverage i j hij
  exact ⟨r, by simpa only [hr] using homogeneousCompletion5_tops r⟩

theorem homogeneousCompletion5_colon (x : MvPolynomial (Fin 6) ℂ)
    (hx : homogeneousCompletion5OriginalPoly (Fin.last 4) * x ∈ homogeneousCompletion5PreviousIdeal) :
    x ∈ homogeneousCompletion5PreviousIdeal := by
  apply colon_of_relation_last_mem (fun i : Fin 4 => homogeneousCompletion5OriginalPoly i.castSucc)
    (homogeneousCompletion5OriginalPoly (Fin.last 4)) ?_ x hx
  intro v hv
  apply homogeneousCompletion5_all_relation_last v
  change (∑ j, v j * (Fin.snoc (Fin.init homogeneousCompletion5OriginalPoly)
    (homogeneousCompletion5OriginalPoly (Fin.last 4)) : Fin 5 → MvPolynomial (Fin 6) ℂ) j) = 0 at hv
  rw [Fin.snoc_init_self] at hv
  exact hv

