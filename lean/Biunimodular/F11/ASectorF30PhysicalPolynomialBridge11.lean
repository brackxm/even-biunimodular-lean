import Biunimodular.F11.ASectorPhysicalFactorBoxes11
import Biunimodular.F11.ASectorF30CharacteristicZero
import Biunimodular.F11.ASectorX77RealCoordinate

set_option autoImplicit false
set_option maxRecDepth 100000
set_option maxHeartbeats 0

namespace Biunimodular.F11

open Polynomial
open scoped IntermediateField

/-- The root-isolation factor in `y=(Im ξ)²` is the degree-thirty monic
polynomial evaluated at `X=4y`. -/
theorem p150F30Y11_eq_aSectorG30_comp_four :
    p150F30Y11 = aSectorG30.comp (C 4 * X) := by
  norm_num [p150F30Y11, aSectorG30, polynomialOfCoefficientsZ,
    p150F30Coeffs11]
  ring

theorem p150F30_factor_eval_eq_G30_scaled (y : ℝ) :
    (p150FactorPolynomialR11 .f30).eval y =
      (aSectorG30.map (Int.castRingHom ℝ)).eval (4 * y) := by
  have hf : p150FactorPolynomialR11 .f30 =
      p150F30Y11.map (Int.castRingHom ℝ) := by
    rw [p150FactorPolynomialR11,
      p150FactorPolynomialQ11_eq_map_integer.2.1, map_map]
    congr 1
  rw [hf, p150F30Y11_eq_aSectorG30_comp_four, map_comp,
    eval_comp]
  simp

/-- The monic degree-thirty equation holds for a genuine phase solution in
one of the three A-tagged candidate boxes. -/
theorem phaseSolution_G30_of_aSectorCandidateBox
    (s : PhaseSolution11) (r q : PhaseCandidateQuintuple11)
    (hr : r ∈ aSectorCandidateOrbitRepresentatives11)
    (hq : q ∈ candidateSymmetryOrbit11 r)
    (hbox : phaseCandidateQuintupleBox11 (1 / 10000) s.1 q) :
    (aSectorG30.map (Int.castRingHom ℝ)).IsRoot
      (4 * s.1.k ^ 2) := by
  have hf := phaseSolution_f30_of_aSectorCandidateBox s r q hr hq hbox
  rw [Polynomial.IsRoot] at hf ⊢
  rw [p150F30_factor_eval_eq_G30_scaled] at hf
  exact hf

/-- In these three physical candidate orbits, the squared last coordinate
has the irreducible degree-thirty polynomial used by the cyclotomic model. -/
theorem phaseSolution_G30_minpoly_of_aSectorCandidateBox
    (s : PhaseSolution11) (r q : PhaseCandidateQuintuple11)
    (hr : r ∈ aSectorCandidateOrbitRepresentatives11)
    (hq : q ∈ candidateSymmetryOrbit11 r)
    (hbox : phaseCandidateQuintupleBox11 (1 / 10000) s.1 q) :
    minpoly ℚ (4 * s.1.k ^ 2 : ℝ) =
      aSectorG30.map (Int.castRingHom ℚ) := by
  have hrootR := phaseSolution_G30_of_aSectorCandidateBox
    s r q hr hq hbox
  have hrootQ : (aeval (4 * s.1.k ^ 2 : ℝ))
      (aSectorG30.map (Int.castRingHom ℚ)) = 0 := by
    have hrootR' : eval₂ (Int.castRingHom ℝ)
        (4 * s.1.k ^ 2 : ℝ) aSectorG30 = 0 := by
      simpa only [eval₂_eq_eval_map] using hrootR.eq_zero
    have hcomp : (algebraMap ℚ ℝ).comp (Int.castRingHom ℚ) =
        Int.castRingHom ℝ := by
      ext n
      simp
    simpa only [aeval_def, eval₂_map, hcomp] using hrootR'
  exact (minpoly.eq_of_irreducible_of_monic
    aSectorG30_irreducible_over_Q hrootQ
    (aSectorG30_monic.map (Int.castRingHom ℚ))).symm

/-- The field generated by the squared coordinate of a phase solution in
one of the three A-tagged boxes is the maximal-real conductor-77 field. -/
noncomputable def phaseSolution_squareCoordinateFieldEquivMaxReal
    (s : PhaseSolution11) (r q : PhaseCandidateQuintuple11)
    (hr : r ∈ aSectorCandidateOrbitRepresentatives11)
    (hq : q ∈ candidateSymmetryOrbit11 r)
    (hbox : phaseCandidateQuintupleBox11 (1 / 10000) s.1 q) :
    ℚ⟮(4 * s.1.k ^ 2 : ℝ)⟯ ≃ₐ[ℚ] Conductor77MaxReal := by
  let y : ℝ := 4 * s.1.k ^ 2
  have hymin : minpoly ℚ y = minpoly ℚ aSectorX77Real := by
    rw [phaseSolution_G30_minpoly_of_aSectorCandidateBox
      s r q hr hq hbox, ← aSectorX77Real_minpoly]
  have hy : IsIntegral ℚ y :=
    minpoly.ne_zero_iff.mp (by
      rw [hymin]
      exact (minpoly.monic (IsIntegral.of_finite ℚ aSectorX77Real)).ne_zero)
  have hx : IsIntegral ℚ aSectorX77Real :=
    IsIntegral.of_finite ℚ aSectorX77Real
  have htop : ℚ⟮aSectorX77Real⟯ =
      (⊤ : IntermediateField ℚ Conductor77MaxReal) :=
    IntermediateField.adjoin_eq_top_iff.mpr
      aSectorX77Real_generates_maxReal
  exact (IntermediateField.adjoinRootEquivAdjoin ℚ hy).symm.trans
    ((AdjoinRoot.algEquivOfEq ℚ _ _ hymin).trans
      ((IntermediateField.adjoinRootEquivAdjoin ℚ hx).trans
        ((IntermediateField.equivOfEq htop).trans
          IntermediateField.topEquiv)))

/-- Each of the three tagged candidate orbits contains a physical solution
whose squared coordinate generates the maximal-real conductor-77 field up to
an explicit rational field isomorphism. -/
theorem aSectorCandidateRepresentatives_realize_degree30 :
    ∀ r ∈ aSectorCandidateOrbitRepresentatives11,
      ∃ s : PhaseSolution11,
        minpoly ℚ (4 * s.1.k ^ 2 : ℝ) =
          aSectorG30.map (Int.castRingHom ℚ) ∧
        Nonempty (ℚ⟮(4 * s.1.k ^ 2 : ℝ)⟯ ≃ₐ[ℚ]
          Conductor77MaxReal) := by
  intro r hr
  obtain ⟨s, hbox⟩ := aSectorCandidateRepresentative_realized11 r hr
  have hmem : r ∈ candidateSymmetryOrbit11 r := by
    simp [candidateSymmetryOrbit11, candidateDilationOrbit11]
  refine ⟨s, phaseSolution_G30_minpoly_of_aSectorCandidateBox
    s r r hr hmem hbox, ?_⟩
  exact ⟨phaseSolution_squareCoordinateFieldEquivMaxReal
    s r r hr hmem hbox⟩

end Biunimodular.F11
