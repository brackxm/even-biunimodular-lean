import Biunimodular.F11.H252ComplexPhaseAlgebra
import Biunimodular.F11.H252OriginalPolynomialBridge

set_option autoImplicit false
set_option maxRecDepth 1000000

namespace Biunimodular.F11

open Polynomial
noncomputable section

/-- The the original coordinate k is the tenth variable b₄. -/
def h252ComplexPhaseKCoordinate : ℂ[X] →ₐ[ℂ] H252ComplexPhaseAlgebra :=
  Polynomial.aeval (h252ComplexPhaseB 4)

theorem h252ComplexPhaseKCoordinate_eliminant_zero :
    h252ComplexPhaseKCoordinate h252KComplex = 0 := by
  have h := congrArg (fun p ↦ h252ComplexPhaseKCoordinate p)
    h252Rur_original_polynomial
  have hrot : h252ComplexPhaseKCoordinate
      (h252RurComplexPolynomial.comp (C Complex.I * X)) =
      h252ComplexPhaseXCoordinate h252RurComplexPolynomial := by
    simp only [h252ComplexPhaseKCoordinate, h252ComplexPhaseXCoordinate,
      Polynomial.aeval_def, Polynomial.eval₂_comp', Polynomial.eval₂_mul,
      Polynomial.eval₂_C, Polynomial.eval₂_X]
  rw [map_mul, map_mul, hrot, h252ComplexPhaseXCoordinate_eliminant_zero, mul_zero] at h
  have hD : (h252RurCommonDen : ℂ) ≠ 0 := by
    exact_mod_cast ne_of_gt h252RurCommonDen_pos
  have hu : IsUnit (h252ComplexPhaseKCoordinate (C (h252RurCommonDen : ℂ))) :=
    ((isUnit_iff_ne_zero.mpr hD).map C).map h252ComplexPhaseKCoordinate.toRingHom
  exact hu.mul_right_eq_zero.mp h.symm

theorem h252ComplexPhaseKCoordinate_root_lift (k : ℂ)
    (hk : h252KComplex.IsRoot k) :
    ∃ g : H252ComplexPhaseAlgebra →ₐ[ℂ] ℂ,
      g (h252ComplexPhaseKCoordinate X) = k := by
  obtain ⟨a, b, hc, h1, h2, h3, h4, h5, hx⟩ :=
    h252RurComplexPhaseRootLift (Complex.I * k) ((h252KComplex_root_iff k).mp hk)
  have hb4 : b 4 = k := mul_left_cancel₀ Complex.I_ne_zero hx
  let hzero := h252ComplexPhasePoint_ideal_zero a b hc h1 h2 h3 h4 h5
  let g : H252ComplexPhaseAlgebra →ₐ[ℂ] ℂ :=
    Ideal.Quotient.liftₐ h252ComplexPhaseIdeal
      (MvPolynomial.aeval (h252ComplexPhasePoint a b))
      (fun _p hp ↦ RingHom.mem_ker.mp (hzero hp))
  refine ⟨g, ?_⟩
  have hb : g (h252ComplexPhaseB 4) = b 4 := by
    simp [g, h252ComplexPhaseB, h252ComplexPhaseBVars,
      h252ComplexPhasePoint]
  simpa only [h252ComplexPhaseKCoordinate, Polynomial.aeval_X, hb] using hb4

theorem h252ComplexPhaseKCoordinate_ker :
    RingHom.ker h252ComplexPhaseKCoordinate =
      Ideal.span ({h252KComplex} : Set ℂ[X]) := by
  exact coordinateKernel_eq_span_of_separable_root_lifts
    h252ComplexPhaseKCoordinate h252KComplex h252KComplex_separable
    (IsAlgClosed.splits _) h252ComplexPhaseKCoordinate_eliminant_zero
    h252ComplexPhaseKCoordinate_root_lift

/-- Eliminate the other nine variables from the ideal generated by the
original five circles and five phase equations, retaining k = b₄. -/
def h252ComplexPhaseEliminationIdeal : Ideal ℂ[X] :=
  Ideal.comap (Polynomial.aeval (MvPolynomial.X (9 : Fin 10)) :
    ℂ[X] →ₐ[ℂ] H252ComplexPhasePolynomialRing).toRingHom h252ComplexPhaseIdeal

theorem h252ComplexPhaseEliminationIdeal_eq_kernel :
    h252ComplexPhaseEliminationIdeal = RingHom.ker h252ComplexPhaseKCoordinate := by
  have hf : h252ComplexPhaseKCoordinate =
      (Ideal.Quotient.mkₐ ℂ h252ComplexPhaseIdeal).comp
        (Polynomial.aeval (MvPolynomial.X (9 : Fin 10))) := by
    apply Polynomial.algHom_ext
    simp [h252ComplexPhaseKCoordinate, h252ComplexPhaseB, h252ComplexPhaseBVars]
  ext p
  change Polynomial.aeval (MvPolynomial.X (9 : Fin 10)) p ∈ h252ComplexPhaseIdeal ↔
    h252ComplexPhaseKCoordinate p = 0
  rw [hf, AlgHom.comp_apply]
  exact Ideal.Quotient.eq_zero_iff_mem.symm

/-- Full complex coordinate elimination: ideal equality, including scheme
multiplicities, with the actual integer factorization H252 = P150 * R102. -/
theorem h252ComplexPhaseEliminationIdeal_eq_span :
    h252ComplexPhaseEliminationIdeal =
      Ideal.span ({h252K11.map (Int.castRingHom ℂ)} : Set ℂ[X]) := by
  rw [h252ComplexPhaseEliminationIdeal_eq_kernel, h252ComplexPhaseKCoordinate_ker]
  rfl

end
end Biunimodular.F11
