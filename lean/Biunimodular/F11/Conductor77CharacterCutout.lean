import Biunimodular.F11.Conductor77PrimitiveCharacter
import Biunimodular.F11.ASectorGaloisGenerator77

set_option autoImplicit false
set_option maxRecDepth 100000
namespace Biunimodular.F11
noncomputable section

local instance : IsCyclotomicExtension {77} ℚ Conductor77Cyclotomic :=
  CyclotomicField.isCyclotomicExtension 77 ℚ

local instance : IsAbelianGalois ℚ Conductor77Cyclotomic :=
  conductor77_isAbelianGalois

/-- The primitive conductor-77 character on the actual cyclotomic Galois
group, using the canonical exponent isomorphism. -/
def conductor77CyclotomicCharacter :
    (Conductor77Cyclotomic ≃ₐ[ℚ] Conductor77Cyclotomic) →* Multiplicative (ZMod 6) :=
  conductor77CharacterUnitHom.comp
    (IsCyclotomicExtension.Rat.galEquivZMod 77 Conductor77Cyclotomic).toMonoidHom

theorem conductor77CyclotomicCharacter_surjective :
    Function.Surjective conductor77CyclotomicCharacter :=
  conductor77CharacterUnitHom_surjective.comp
    (IsCyclotomicExtension.Rat.galEquivZMod 77 Conductor77Cyclotomic).surjective

private theorem conductor77Sigma62_exponent :
    IsCyclotomicExtension.Rat.galEquivZMod 77 Conductor77Cyclotomic conductor77Sigma62 =
      ZMod.unitOfCoprime 62 (by decide) := by
  exact (IsCyclotomicExtension.Rat.galEquivZMod 77
    Conductor77Cyclotomic).apply_symm_apply _

theorem conductor77Sigma62_order : orderOf conductor77Sigma62 = 10 := by
  rw [← (IsCyclotomicExtension.Rat.galEquivZMod 77
    Conductor77Cyclotomic).orderOf_eq, conductor77Sigma62_exponent]
  apply (orderOf_eq_iff (by decide : 0 < 10)).mpr
  constructor
  · native_decide
  · intro m hm hpos
    have ht : ∀ m : Fin 10, 0 < m.val →
        (ZMod.unitOfCoprime 62 (by decide) : (ZMod 77)ˣ) ^ m.val ≠ 1 := by native_decide
    exact ht ⟨m, hm⟩ hpos

/-- The actual Galois character kernel is the ten-element subgroup fixing
the displayed period, generated by the exponent-62 automorphism. -/
theorem conductor77CyclotomicCharacter_kernel :
    conductor77CyclotomicCharacter.ker = Subgroup.zpowers conductor77Sigma62 := by
  apply le_antisymm
  · intro σ hσ
    have hc : conductor77CharacterUnitHom
        (IsCyclotomicExtension.Rat.galEquivZMod 77 Conductor77Cyclotomic σ) = 1 :=
      MonoidHom.mem_ker.mp hσ
    have ht : ∀ u : (ZMod 77)ˣ, conductor77CharacterUnitHom u = 1 ↔
        ∃ j : Fin 10, u = (ZMod.unitOfCoprime 62 (by decide)) ^ j.val := by native_decide
    obtain ⟨j, hj⟩ := (ht _).mp hc
    have he : σ = conductor77Sigma62 ^ j.val := by
      apply (IsCyclotomicExtension.Rat.galEquivZMod 77 Conductor77Cyclotomic).injective
      rw [map_pow, conductor77Sigma62_exponent]
      exact hj
    rw [he]
    exact Subgroup.npow_mem_zpowers _ _
  · apply Subgroup.zpowers_le.mpr
    apply MonoidHom.mem_ker.mpr
    change conductor77CharacterUnitHom
      (IsCyclotomicExtension.Rat.galEquivZMod 77 Conductor77Cyclotomic conductor77Sigma62) = 1
    rw [conductor77Sigma62_exponent]
    native_decide

theorem conductor77CyclotomicCharacter_kernel_card :
    Nat.card conductor77CyclotomicCharacter.ker = 10 := by
  rw [conductor77CyclotomicCharacter_kernel, Nat.card_zpowers, conductor77Sigma62_order]

/-- The the actual sextic field is precisely the field cut out by its
primitive even conductor-77 character. -/
theorem conductor77PeriodField_eq_character_fixedField :
    conductor77PeriodField = IntermediateField.fixedField conductor77CyclotomicCharacter.ker := by
  have hle : conductor77PeriodField ≤
      IntermediateField.fixedField conductor77CyclotomicCharacter.ker := by
    apply (IntermediateField.le_iff_le _ _).mpr
    rw [conductor77CyclotomicCharacter_kernel]
    apply Subgroup.zpowers_le.mpr
    apply (IntermediateField.mem_fixingSubgroup_iff _ _).mpr
    intro x hx
    exact conductor77Sigma62_fixes_periodField ⟨x, hx⟩
  have hr : Module.finrank
      (IntermediateField.fixedField conductor77CyclotomicCharacter.ker) Conductor77Cyclotomic = 10 := by
    rw [IntermediateField.finrank_fixedField_eq_card, conductor77CyclotomicCharacter_kernel_card]
  have ht := Module.finrank_mul_finrank ℚ
    (IntermediateField.fixedField conductor77CyclotomicCharacter.ker) Conductor77Cyclotomic
  rw [hr, conductor77_cyclotomic_finrank] at ht
  have hd : Module.finrank ℚ
      (IntermediateField.fixedField conductor77CyclotomicCharacter.ker) = 6 := by omega
  apply IntermediateField.eq_of_le_of_finrank_eq hle
  rw [conductor77PeriodField_finrank, hd]

end
end Biunimodular.F11
