namespace Biunimodular.F11

/-! Finite word data for the degree-eight 8/7/5 generation check. -/

abbrev S8Word := List Nat

/-- Four letters encode the canonical 8-cycle, its inverse, a 7-cycle, and
its inverse. -/
def s8WordLetter (a b : Equiv.Perm (Fin 8)) (n : Nat) :
    Equiv.Perm (Fin 8) :=
  match n with
  | 0 => a
  | 1 => a⁻¹
  | 2 => b
  | _ => b⁻¹

def s8EvalWord (a b : Equiv.Perm (Fin 8)) (w : S8Word) :
    Equiv.Perm (Fin 8) :=
  w.foldl (fun p n => p * s8WordLetter a b n) 1

/-- The canonical 8-cycle used after conjugating the 8-cycle supplied by
Dedekind. -/
def s8CanonicalEight : Equiv.Perm (Fin 8) := c[0,1,2,3,4,5,6,7]

/-- The 12 normalized 7-cycles for which the 8/7 pair generates an
order-336 subgroup. -/
def s8ExceptionalSeven : List (Equiv.Perm (Fin 8)) := [
  c[0,1,4,2,5,6,3],
  c[0,1,4,3,2,5,6],
  c[0,2,1,5,4,6,3],
